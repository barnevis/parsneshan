{
  "name": "parsneshan",
  "version": "0.2.0",
  "description": "Markdown library with extensions for Persian, built on micromark",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./extensions/warning": "./extensions/warning/index.js",
    "./extensions/caution": "./extensions/caution/index.js",
    "./extensions/important": "./extensions/important/index.js",
    "./extensions/tip": "./extensions/tip/index.js",
    "./extensions/note": "./extensions/note/index.js",
    "./extensions/persian-list": "./extensions/persian-list/index.js",
    "./extensions/persian-poem": "./extensions/persian-poem/index.js",
    "./extensions/persian-footnote": "./extensions/persian-footnote/index.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "playground": "node playground/server.js"
  },
  "files": [
    "index.js",
    "extensions/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "markdown",
    "micromark",
    "markdown-extension",
    "micromark-extension",
    "persian",
    "farsi"
  ],
  "author": "barnevis",
  "license": "MIT",
  "dependencies": {
    "micromark": "^4.0.2",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2"
  }
}